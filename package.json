{
  "name": "learn-chess-opening",
  "version": "0.1.0",
  "private": true,
  "description": "Opening repetition training platform — local-first prototype of the adaptive repetition engine.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --fresh && tsx scripts/seed.ts",
    "db:inspect": "tsx scripts/inspect.ts",
    "prepare:db": "npm run db:migrate && npm run db:seed",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "next": "16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
